# Credenciais e variáveis de ambiente — nunca versionar
.env
.env.local
.env.*.local
*.key
*.pem
google-services.json
GoogleService-Info.plist
# Arquivos de assinatura do Android costumam guardar senha de keystore
gradle.properties
keystore.properties

# Dependências
node_modules/
.pnp
.pnp.js

# Build e artefatos
build/
dist/
*.apk
*.aab
*.keystore
*.jks

# Projeto nativo gerado pelo `expo prebuild` — artefato, não código-fonte.
# É recriado a partir de app/app.json sempre que necessário e carrega o
# debug.keystore e o gradle.properties do template.
# O APK sai em app/android/app/build/outputs/apk/.
app/android/
app/ios/

# Sistema operacional
.DS_Store
Thumbs.db

# Editores e ferramentas locais
.vscode/
.idea/
*.swp
.kiro/
.agents/

# Material de preparação da equipe: slides, documentos de entrega e
# norteadores da disciplina. Não é redistribuído e não compõe o projeto.
nao-publicar/

# Documentos em PDF não são versionados: o material de referência da
# disciplina não é redistribuído e os documentos do projeto são gerados
# a partir dos arquivos Markdown em docs/
*.pdf
