{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    // Import só de tipo precisa dizer "type". Os testes carregam o código
    // no Node, que apaga os tipos sem consultar o compilador.
    "verbatimModuleSyntax": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "tests", "android", "ios"]
}
